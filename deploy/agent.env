# Settings shared by the agents in docker-compose.yml. Each agent sets its own
# AGENT_INSTANCE there. Overrides go in compose.env (git-ignored).
#
# An agent needs only RabbitMQ (and the OpenResty in its own container).

AMQP_URL=amqp://guest:guest@host.docker.internal:5673/
AGENT_SERVICE=edge
AGENT_HEARTBEAT_INTERVAL=10s
