# Settings for the manager in docker-compose.yml.
# Do not edit for local changes: put overrides in compose.env at the
# repository root (git-ignored); values there win.
#
# The defaults reach the services from compose.infra.yml through their
# published host ports. To use existing servers, set the URLs in compose.env
# ("localhost" inside a container is the container itself; use
# host.docker.internal for services on the Docker host).

DATABASE_URL=postgres://openresty:openresty@host.docker.internal:15432/openresty?sslmode=disable
AMQP_URL=amqp://guest:guest@host.docker.internal:5673/
REDIS_URL=redis://host.docker.internal:26379/0

# First prosecutor, created only when the users table is empty.
# Local development only: override in compose.env for anything else.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin12345
