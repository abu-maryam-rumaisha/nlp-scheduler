# Copy to .env for running from source:
#   go run .              # manager (API + web UI)
#   go run ./cmd/agent    # agent, next to a local OpenResty
# Real environment variables override anything here. The URLs point at the
# services from `docker compose -f compose.infra.yml up -d`; change them to
# use existing Postgres / RabbitMQ / Redis instead.

AMQP_URL=amqp://guest:guest@localhost:5673/
AMQP_EXCHANGE=openresty

# --- Manager -----------------------------------------------------------------
HTTP_ADDR=:8080
DATABASE_URL=postgres://openresty:openresty@localhost:15432/openresty?sslmode=disable
REDIS_URL=redis://localhost:26379/0
SESSION_TTL=12h
INSTANCE_ONLINE_WINDOW=90s
STARTUP_TIMEOUT=60s

# First prosecutor, created only when the users table is empty.
# Local development only: use a strong password anywhere else.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin12345

# --- Agent -------------------------------------------------------------------
# Only read by the agent. AGENT_SERVICE is required; AGENT_INSTANCE defaults
# to the hostname.
# AGENT_INSTANCE=local-1
# AGENT_SERVICE=local
# AGENT_CONF_DIR=/usr/local/openresty/nginx/conf/conf.d
# AGENT_TEST_CMD=openresty -t
# AGENT_RELOAD_CMD=openresty -s reload
# AGENT_HEARTBEAT_INTERVAL=30s
# AGENT_COMMAND_TIMEOUT=30s
